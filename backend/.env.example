# Copy to .env and fill in. APP_SECRET encrypts stored tokens (any long random string, keep it stable).
APP_SECRET=

# Public address of this backend (https://dashboard.yourcompany.com when hosted); used in the setup
# command, the AI config files and the Jira/Figma OAuth callbacks.
PUBLIC_BASE_URL=http://localhost:8000

# Figma and Jira need no settings: the dashboard registers itself with their MCP servers automatically
# the first time someone clicks Connect. PUBLIC_BASE_URL must be the address the browser can reach.

# Database; SQLite file by default, e.g. postgresql+psycopg://user:pass@host/db later.
# DATABASE_URL=sqlite:///data/app.db

# "Connect with Jira": create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps
# with scopes read:jira-work and offline_access and callback URL <PUBLIC_BASE_URL>/api/jira/callback.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
